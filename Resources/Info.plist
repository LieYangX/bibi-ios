<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>星枢</string>
    <key>CFBundleName</key>
    <string>星枢</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于在您明确询问当前位置时，将设备位置提供给智能体。</string>
    <key>NSContactsUsageDescription</key>
    <string>用于在您明确要求查找联系人时，搜索系统通讯录。</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>用于在您明确询问日程时，读取系统日历中的事件。</string>
    <key>NSHealthShareUsageDescription</key>
    <string>用于在您询问健康运动数据时，读取系统健康中的步数、心率、睡眠等信息。</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>用于将您的语音指令实时转写为文字，方便向星枢提问。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>用于在您使用语音输入时，录制并识别您的声音。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>用于在同一局域网内发现并连接笔笔电脑版，实现记账、日程等电脑端工具。</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_bibi-tools._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.lieyang.starnexus.proactiveMessage</string>
    </array>
</dict>
</plist>
